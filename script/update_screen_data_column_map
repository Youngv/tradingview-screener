#!/usr/bin/env ruby
# frozen_string_literal: true

require "net/http"
require "uri"

PAGE_URL = "https://www.tradingview.com/screener/"
OUTPUT = File.expand_path("../lib/tradingview_screener/generated_column_map.rb", __dir__)
MINIMUM_COLUMNS = 400

def get(url, redirects: 5)
  raise "too many redirects for #{url}" if redirects.negative?

  uri = URI(url)
  response = Net::HTTP.get_response(uri)
  case response
  when Net::HTTPSuccess
    response.body
  when Net::HTTPRedirection
    get(URI.join(url, response.fetch("location")).to_s, redirects: redirects - 1)
  else
    raise "GET #{url} failed: HTTP #{response.code}"
  end
end

page = get(PAGE_URL)
bundle_urls = page.scan(%r{https://static\.tradingview\.com/static/bundles/[^" ]+\.js}).uniq
raise "no TradingView bundles found" if bundle_urls.empty?

bundles = bundle_urls.to_h { |url| [url, get(url)] }
enum_source = bundles.find { |_url, body| body.include?("TableColumnIdMapValues") }
definition_source = bundles.find { |_url, body| body.include?("[V.TableColumnIdMap.") }
raise "TableColumnIdMap enum bundle not found" unless enum_source
raise "table column definition bundle not found" unless definition_source

enum_body = enum_source.last
module_start = enum_body.index("TableColumnIdMap:()")
raise "TableColumnIdMap enum module not found" unless module_start

enum_pairs = enum_body[module_start..].scan(/e\.([A-Za-z0-9_$]+)="([^"]+)"/).to_h

definition_body = definition_source.last
registry_pairs = definition_body.scan(/\[V\.TableColumnIdMap\.([A-Za-z0-9_$]+)\]:([A-Za-z0-9_$]+)/).to_h
column_map = {}

registry_pairs.each do |enum_name, variable|
  assignment = definition_body.match(/const #{Regexp.escape(variable)}=O\(([A-Za-z0-9_$]+)/)
  next unless assignment

  class_name = assignment[1]
  class_start = definition_body.rindex("class #{class_name} ", assignment.begin(0))
  next unless class_start

  class_body = definition_body[class_start...assignment.begin(0)]
  base_keys = class_body.scan(/this\._key="([^"]+)"/).flatten
  ui_id = enum_pairs[enum_name]
  column_map[ui_id] = base_keys.last if ui_id && base_keys.any?
end

if column_map.size < MINIMUM_COLUMNS
  raise "extracted only #{column_map.size} columns; expected at least #{MINIMUM_COLUMNS}"
end

enum_bundle = File.basename(URI(enum_source.first).path)
definition_bundle = File.basename(URI(definition_source.first).path)
lines = column_map.sort.map { |ui_id, field| "        #{ui_id.inspect} => #{field.inspect}," }
lines[-1] = lines.last.delete_suffix(",")

content = <<~RUBY
  # frozen_string_literal: true

  module TradingviewScreener
    module ScreenData
      # Generated by script/update_screen_data_column_map from TradingView's
      # development-time bundles. Runtime conversion never downloads these files.
      # Enum bundle: #{enum_bundle}
      # Definition bundle: #{definition_bundle}
      GENERATED_COLUMN_BASE_MAP = {
  #{lines.join("\n")}
      }.freeze
    end
  end
RUBY

File.write(OUTPUT, content)
puts "wrote #{column_map.size} column mappings to #{OUTPUT}"
